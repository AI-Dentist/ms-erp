scalar UUID
scalar BigDecimal
scalar Date
scalar DateTime

type Query {
    estadoOperacionOffline(sessionId: UUID!, operationId: UUID!): OfflineOperationReceipt!
    obtenerConfiguracionEmpresa: EmpresaConfig!
    listarUsuarios: [Usuario!]!
    # ADMIN/CAJERO: exact verified JWT subject -> active ERP user, without a doctor dependency.
    obtenerMiUsuarioId: UUID!
    listarRoles: [Rol!]!
    listarAuditLogs(limite: Int = 50): [AuditLog!]!

    listarPacientes(busqueda: String): [Paciente!]!
    obtenerPacientePorId(id: UUID!): Paciente
    listarOdontologos(soloActivos: Boolean = true): [Odontologo!]!
    # Canonical identity from the verified JWT subject, never a caller-supplied identifier.
    obtenerMiOdontologoId: UUID!
    listarEspecialidades: [Especialidad!]!
    listarConsultorios: [Consultorio!]!
    listarServiciosOdontologicos(especialidadId: UUID): [ServicioOdontologico!]!

    obtenerGastoPagadoPaciente(pacienteId: UUID!): GastoPagadoPaciente!
    listarOrdenesCobro(estado: EstadoOrdenCobro, pacienteId: UUID): [OrdenCobro!]!
    obtenerOrdenCobroDetalle(id: UUID!): OrdenCobro
    listarCuotasPendientesPorPaciente(pacienteId: UUID!): [CuotaPago!]!
    obtenerFlujoCaja(fechaInicio: DateTime!, fechaFin: DateTime!): ResumenFlujoCaja!
}

input ActivarJornadaOfflineInput {
    workspaceId: UUID!
    deviceId: UUID!
    durationSeconds: Int = 28800
}

type JornadaOffline {
    credencial: String!
    clavePublicaSpki: String!
}

input PrepararSyncOfflineInput {
    workspaceId: UUID!
    deviceId: UUID!
    expectedActorId: UUID!
}

type OfflineSyncChallenge {
    sessionId: UUID!
    actorId: UUID!
    workspaceId: UUID!
    deviceId: UUID!
    reauthNotBefore: DateTime!
    expiresAt: DateTime!
    cashflowBalanceBs: BigDecimal
}

type OfflineSyncSession {
    sessionId: UUID!
    actorId: UUID!
    workspaceId: UUID!
    deviceId: UUID!
    authenticatedAt: DateTime!
    expiresAt: DateTime!
}

type Mutation {
    sincronizarOperacionOffline(input: OfflineOperationInput!): OfflineOperationReceipt!
    prepararSyncOffline(input: PrepararSyncOfflineInput!): OfflineSyncChallenge!
    confirmarSyncOffline(sessionId: UUID!): OfflineSyncSession!
    activarJornadaOffline(input: ActivarJornadaOfflineInput!): JornadaOffline!
    actualizarConfiguracionEmpresa(input: EmpresaConfigInput!): EmpresaConfig!
    crearUsuario(input: CrearUsuarioInput!): Usuario!
    "ADMIN: atomically create an ERP user, bind an existing Keycloak subject and optionally an existing dentist."
    crearUsuarioConIdentidad(input: CrearUsuarioConIdentidadInput!): Usuario!
    vincularIdentidadUsuario(input: VincularIdentidadUsuarioInput!): UUID!
    crearPaciente(input: CrearPacienteInput!): Paciente!
    crearEspecialidad(codigo: String!, nombre: String!, descripcion: String): Especialidad!
    crearOdontologo(input: CrearOdontologoInput!): Odontologo!
    vincularIdentidadOdontologo(input: VincularIdentidadOdontologoInput!): UUID!
    crearConsultorio(input: CrearConsultorioInput!): Consultorio!
    crearServicioOdontologico(input: CrearServicioInput!): ServicioOdontologico!

    # Updates replace every field of the matching Crear*Input. eliminar* is logical deactivation (never a DELETE),
    # idempotent, and returns true. Consultorio has no activo column: its deactivation is estado = INACTIVO.
    actualizarPaciente(id: UUID!, input: ActualizarPacienteInput!): Paciente!
    actualizarOdontologo(id: UUID!, input: ActualizarOdontologoInput!): Odontologo!
    actualizarEspecialidad(id: UUID!, input: ActualizarEspecialidadInput!): Especialidad!
    actualizarConsultorio(id: UUID!, input: ActualizarConsultorioInput!): Consultorio!
    actualizarServicioOdontologico(id: UUID!, input: ActualizarServicioInput!): ServicioOdontologico!
    actualizarUsuario(id: UUID!, input: ActualizarUsuarioInput!): Usuario!
    eliminarPaciente(id: UUID!): Boolean!
    eliminarOdontologo(id: UUID!): Boolean!
    eliminarEspecialidad(id: UUID!): Boolean!
    eliminarConsultorio(id: UUID!): Boolean!
    eliminarServicioOdontologico(id: UUID!): Boolean!

    crearOrdenCobroManual(input: CrearOrdenCobroInput!): OrdenCobro!
    configurarPlanDePagos(input: ConfigurarPlanPagosInput!): OrdenCobro!

    cobrarCuotaEnEfectivo(input: CobrarEfectivoInput!): Recibo!
    generarQrPagoFacil(cuotaId: UUID!, ciNitCliente: String!, razonSocialCliente: String!): TransaccionQr!
    verificarPagoQrPagoFacil(pagofacilTransactionId: String!): Recibo
    simularConfirmacionQrDev(pagofacilTransactionId: String!): Recibo!

    registrarEgresoCaja(input: RegistrarEgresoInput!): MovimientoCaja!
}

enum ModalidadPago { CONTADO CREDITO }
enum EstadoOrdenCobro { PENDIENTE PARCIAL PAGADO ANULADO }
enum EstadoCuota { PENDIENTE PAGADA VENCIDA ANULADA }
enum TipoMovimientoCaja { INGRESO EGRESO }
enum MetodoPago { EFECTIVO QR_PAGOFACIL TRANSFERENCIA }

type EmpresaConfig {
    id: UUID!
    nombreComercial: String!
    razonSocial: String!
    nit: String!
    direccion: String!
    telefonoContacto: String!
    emailContacto: String
    monedaSimbolo: String!
}

type Rol {
    id: UUID!
    codigo: String!
    nombre: String!
    permisos: [String!]!
}

type Usuario {
    id: UUID!
    username: String!
    email: String!
    nombreCompleto: String!
    rol: Rol!
    activo: Boolean!
}

type AuditLog {
    id: UUID!
    accion: String!
    entidadAfectada: String!
    entidadId: UUID
    detalleJson: String
    createdAt: DateTime!
}

type Paciente {
    id: UUID!
    ciNit: String!
    nombres: String!
    apellidos: String!
    fechaNacimiento: Date
    genero: String
    telefonoWhatsapp: String!
    email: String
    direccion: String
    activo: Boolean!
}

type Especialidad {
    id: UUID!
    codigo: String!
    nombre: String!
    descripcion: String
    activo: Boolean!
}

type Odontologo {
    id: UUID!
    ci: String!
    matriculaProfesional: String!
    nombres: String!
    apellidos: String!
    telefono: String!
    email: String
    porcentajeComision: BigDecimal!
    especialidades: [Especialidad!]!
    activo: Boolean!
}

type Consultorio {
    id: UUID!
    codigo: String!
    nombre: String!
    ubicacion: String
    estado: String!
}

type ServicioOdontologico {
    categoria: String
    id: UUID!
    codigo: String!
    nombre: String!
    descripcion: String
    precioBaseBs: BigDecimal!
    especialidad: Especialidad
    activo: Boolean!
}

type GastoPagadoPaciente {
    pacienteId: UUID!
    moneda: String!
    completo: Boolean!
    totalPagadoBs: BigDecimal
}

type OrdenCobro {
    id: UUID!
    paciente: Paciente!
    odontologo: Odontologo
    consultaExternaId: UUID
    modalidadPago: ModalidadPago!
    montoSubtotalBs: BigDecimal!
    descuentoBs: BigDecimal!
    montoTotalBs: BigDecimal!
    saldoPendienteBs: BigDecimal!
    cantidadCuotas: Int!
    estado: EstadoOrdenCobro!
    items: [OrdenCobroItem!]!
    cuotas: [CuotaPago!]!
    createdAt: DateTime!
}

type OrdenCobroItem {
    id: UUID!
    servicio: ServicioOdontologico!
    piezaDental: String
    cantidad: Int!
    precioUnitarioBs: BigDecimal!
    subtotalBs: BigDecimal!
}

type CuotaPago {
    id: UUID!
    numeroCuota: Int!
    montoCuotaBs: BigDecimal!
    fechaVencimiento: Date!
    estado: EstadoCuota!
    fechaPago: DateTime
}

type TransaccionQr {
    id: UUID!
    cuotaId: UUID!
    pagofacilTransactionId: String!
    qrImagenBase64: String!
    montoBs: BigDecimal!
    estado: String!
    fechaExpiracion: DateTime
}

type MovimientoCaja {
    id: UUID!
    tipoMovimiento: TipoMovimientoCaja!
    categoria: String!
    metodoPago: MetodoPago!
    montoBs: BigDecimal!
    descripcion: String!
    fechaMovimiento: DateTime!
    recibo: Recibo
}

type Recibo {
    id: UUID!
    numeroRecibo: String!
    ciNitCliente: String!
    razonSocialCliente: String!
    concepto: String!
    montoTotalBs: BigDecimal!
    pdfUrlS3: String
    enviadoWhatsapp: Boolean!
    fechaEmision: DateTime!
}

type ResumenFlujoCaja {
    totalIngresosBs: BigDecimal!
    totalEgresosBs: BigDecimal!
    saldoNetoBs: BigDecimal!
    movimientos: [MovimientoCaja!]!
}

input EmpresaConfigInput {
    nombreComercial: String!
    razonSocial: String!
    nit: String!
    direccion: String!
    telefonoContacto: String!
    emailContacto: String
}

input CrearUsuarioInput {
    rolCodigo: String!
    username: String!
    email: String!
    nombreCompleto: String!
    password: String!
}

"Exact active replay is read-only; conflicting profile, credentials or dentist cannot overwrite an existing identity."
input CrearUsuarioConIdentidadInput {
    usuario: CrearUsuarioInput!
    keycloakSubject: String!
    odontologoId: UUID
}

"ADMIN user-only provisioning; opaque subject unchanged, nonblank, at most 100 Unicode code points."
input VincularIdentidadUsuarioInput {
    usuarioId: UUID!
    keycloakSubject: String!
}

input CrearPacienteInput {
    ciNit: String!
    nombres: String!
    apellidos: String!
    fechaNacimiento: Date
    genero: String
    telefonoWhatsapp: String!
    email: String
    direccion: String
}

input CrearOdontologoInput {
    ci: String!
    matriculaProfesional: String!
    nombres: String!
    apellidos: String!
    telefono: String!
    email: String
    porcentajeComision: BigDecimal!
    especialidadesIds: [UUID!]!
}

"ADMIN provisioning only; subject is opaque, case-sensitive, nonblank, at most 100 characters."
input VincularIdentidadOdontologoInput {
    usuarioId: UUID!
    odontologoId: UUID!
    keycloakSubject: String!
}

input CrearConsultorioInput {
    codigo: String!
    nombre: String!
    ubicacion: String
}

input CrearServicioInput {
    especialidadId: UUID
    codigo: String!
    nombre: String!
    descripcion: String
    precioBaseBs: BigDecimal!
}

input ActualizarPacienteInput {
    ciNit: String!
    nombres: String!
    apellidos: String!
    fechaNacimiento: Date
    genero: String
    telefonoWhatsapp: String!
    email: String
    direccion: String
}

input ActualizarOdontologoInput {
    ci: String!
    matriculaProfesional: String!
    nombres: String!
    apellidos: String!
    telefono: String!
    email: String
    porcentajeComision: BigDecimal!
    especialidadesIds: [UUID!]!
}

input ActualizarEspecialidadInput {
    codigo: String!
    nombre: String!
    descripcion: String
}

"estado, when present, must be DISPONIBLE, MANTENIMIENTO or INACTIVO; omitted keeps the current one"
input ActualizarConsultorioInput {
    codigo: String!
    nombre: String!
    ubicacion: String
    estado: String
}

input ActualizarServicioInput {
    especialidadId: UUID
    codigo: String!
    nombre: String!
    descripcion: String
    precioBaseBs: BigDecimal!
}

"nombreCompleto and email, when omitted, keep their current value; username and password never change"
input ActualizarUsuarioInput {
    rolCodigo: String!
    activo: Boolean!
    nombreCompleto: String
    email: String
}

input OrdenCobroItemInput {
    servicioId: UUID!
    piezaDental: String
    cantidad: Int!
}

input CrearOrdenCobroInput {
    pacienteId: UUID!
    odontologoId: UUID
    items: [OrdenCobroItemInput!]!
    descuentoBs: BigDecimal = 0
    observaciones: String
}

input ConfigurarPlanPagosInput {
    ordenCobroId: UUID!
    modalidadPago: ModalidadPago!
    descuentoBs: BigDecimal = 0
    cantidadCuotas: Int!
    fechaPrimeraCuota: Date!
    intervaloDias: Int = 30
}

input CobrarEfectivoInput {
    cuotaId: UUID!
    usuarioCajeroId: UUID!
    ciNitCliente: String!
    razonSocialCliente: String!
}

input RegistrarEgresoInput {
    usuarioCajeroId: UUID!
    categoria: String!
    metodoPago: MetodoPago!
    montoBs: BigDecimal!
    descripcion: String!
}

# ---- Co-Piloto & Monitor de Negocio ERP: single AI entry point (agent) and MCP server status ----
extend type Query {
    obtenerEstadoServidorMcp: McpServerStatus!
    listarHistorialAgente(limite: Int = 20): [AgenteInteraccionResponse!]!
}

extend type Mutation {
    ejecutarAgenteErp(instruccion: String!, modoAutonomoMonitoreo: Boolean = false): AgenteInteraccionResponse!
}

type McpServerStatus {
    activo: Boolean!
    protocolVersion: String!
    toolsRegistradas: [McpToolMetadata!]!
}

type McpToolMetadata {
    nombre: String!
    categoria: String!
    descripcion: String!
}

type RespuestaAgenteErp {
    interaccionId: UUID!
    fechaEjecucion: DateTime!
    instruccionOriginal: String!
    respuestaNaturalAgente: String!
    toolsMcpInvocadas: [String!]!
    accionCrudEjecutada: String
    notificacionN8nEnviada: Boolean!
    reporteGenerado: ReporteGenerativoPayload
    notificacionMulticanal: NotificacionMulticanalPayload
}

type AgenteInteraccionResponse {
    interaccionId: UUID!
    fechaEjecucion: DateTime!
    instruccionOriginal: String!
    respuestaNaturalAgente: String!
    toolsMcpInvocadas: [String!]!
    accionCrudEjecutada: String
    notificacionN8nEnviada: Boolean!
    reporteGenerado: ReporteGenerativoPayload
    notificacionMulticanal: NotificacionMulticanalPayload
}

type NotificacionMulticanalPayload {
    exito: Boolean!
    modoEjecucion: String!
    resultadosPorCanal: [ResultadoCanalNotificacion!]!
}

type ResultadoCanalNotificacion {
    canal: String!
    proveedor: String!
    estado: String!
    destino: String!
}

type ReporteGenerativoPayload {
    reporteId: UUID!
    "SQL ejecutado (alias: sqlGenerado)"
    consultaSqlEjecutada: String!
    columnas: [String!]!
    "Filas serializadas como JSON para compatibilidad hacia atrás"
    filasJson: String!
    tipoGraficoSugerido: String!
    urlDescargaExcel: String!
    urlDescargaPdf: String!
    "Título legible derivado de la solicitud original"
    titulo: String!
    "SQL ejecutado (nombre canónico S6)"
    sqlGenerado: String!
    "Filas como arreglo de arreglos de texto para renderizado directo en tabla"
    filas: [[String]]
    "Resumen analítico generado a partir de los datos del reporte"
    resumenAnalitico: String!
}


enum OfflineOperationType { CASH_PAYMENT CASH_EXPENSE MANUAL_ORDER PATIENT_CREATE }
enum OfflineOperationState { PREPARED CONFIRMED CONFLICT BLOCKED NOT_FOUND }
type OfflineOperationReceipt {
    operationId: UUID!
    type: OfflineOperationType
    state: OfflineOperationState!
    payloadHash: String
    reasonCode: String
    confirmedAt: DateTime
    result: OfflineConfirmedResult
}
type OfflineConfirmedResult {
    patientId: UUID
    orderId: UUID
    installments: [OfflineInstallmentId!]!
    movementId: UUID
    receiptId: UUID
}
type OfflineInstallmentId { number: Int!, id: UUID! }


input OfflineOperationInput {
    sessionId: UUID!
    operationId: UUID!
    type: OfflineOperationType!
    cash: OfflineCashInput
    expense: OfflineExpenseInput
    order: OfflineOrderInput
    patient: CrearPacienteInput
}
input OfflineReferenceInput {
    id: UUID
    operationId: UUID
    installmentNumber: Int
}
input OfflineCashInput {
    quota: OfflineReferenceInput!
    expectedOrderState: EstadoOrdenCobro!
    expectedQuotaState: EstadoCuota!
    expectedOrderBalanceBs: BigDecimal!
    expectedQuotaAmountBs: BigDecimal!
    ciNitCliente: String!
    razonSocialCliente: String!
    requireOpenCashRegister: Boolean = false
}
input OfflineExpenseInput {
    categoria: String!
    metodoPago: MetodoPago!
    montoBs: BigDecimal!
    descripcion: String!
    expectedCashflowBalanceBs: BigDecimal!
    requireOpenCashRegister: Boolean = false
}
input OfflineOrderInput {
    patient: OfflineReferenceInput!
    odontologoId: UUID
    items: [OfflineOrderItemInput!]!
    descuentoBs: BigDecimal = 0
    observaciones: String
    expectedTotalBs: BigDecimal!
}
input OfflineOrderItemInput {
    servicioId: UUID!
    piezaDental: String
    cantidad: Int!
    expectedUnitPriceBs: BigDecimal!
}
